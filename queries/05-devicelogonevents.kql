// Part 5: DeviceLogonEvents hunting (endpoint logons via Defender for Endpoint)
// Schema: https://learn.microsoft.com/en-us/azure/azure-monitor/reference/tables/devicelogonevents
// Source: use cases 1-3 are starting queries provided with the lab environment.
//         Use case 4 was AI-generated (Claude) and also provided with the lab.
// Changes by me are marked "// changed:"

// Set the investigation window once at the top, reuse it everywhere.
// If these dates come back empty, swap in a recent range.
let startTime = datetime(2026-06-01 00:00:00);
let endTime = datetime(2026-06-02 00:00:00);


// USE CASE 1: Failed logons / brute force
// Counts failed attempts per source + device. A spike from one RemoteIP
// or against one account is a brute force signal.
// ATT&CK T1110 Brute Force | NIST CSF 2.0 DE.CM-03
DeviceLogonEvents
| where TimeGenerated between (startTime .. endTime)
| where ActionType == "LogonFailed"
| summarize FailedCount = count(), Accounts = make_set(AccountName, 20)
    by RemoteIP, DeviceName, FailureReason
| where FailedCount > 10
| sort by FailedCount desc


// USE CASE 2: Successful logon following failures (possible breach)
// Joins failures and successes on the same account + device + IP.
// Note: the join doesn't check order. A success BEFORE the failures still matches.
// ATT&CK T1110 Brute Force, T1078 Valid Accounts | NIST CSF 2.0 DE.CM-03
let failures =
    DeviceLogonEvents
    | where TimeGenerated between (startTime .. endTime)
    | where ActionType == "LogonFailed"
    | summarize Failures = count() by AccountName, DeviceName, RemoteIP;
let successes =
    DeviceLogonEvents
    | where TimeGenerated between (startTime .. endTime)
    | where ActionType == "LogonSuccess"
    | summarize Successes = count(), LastSuccess = max(TimeGenerated)
        by AccountName, DeviceName, RemoteIP;
failures
| join kind=inner successes on AccountName, DeviceName, RemoteIP
| where Failures > 10 and Successes > 0
| project AccountName, DeviceName, RemoteIP, Failures, Successes, LastSuccess
| sort by Failures desc


// USE CASE 3: Remote logons from public IPs
// RemoteIPType filters out internal (private) traffic.
// ATT&CK T1133 External Remote Services, T1021.001 Remote Desktop Protocol | NIST CSF 2.0 DE.CM-03
DeviceLogonEvents
| where TimeGenerated between (startTime .. endTime)
| where ActionType == "LogonSuccess"
| where LogonType in ("RemoteInteractive", "Network", "Unlock")
| where RemoteIPType == "Public"
| project Timestamp, DeviceName, AccountName, LogonType, RemoteIP, RemotePort, Protocol
| sort by Timestamp desc


// USE CASE 4: Lateral movement (AI-GENERATED by Claude, provided with the lab)
// Note: no startTime/endTime filter, so it runs against the portal's time range picker.
// ATT&CK T1021 Remote Services, T1078 Valid Accounts | NIST CSF 2.0 DE.CM-03
DeviceLogonEvents
| where ActionType == "LogonSuccess"                  // only count footholds that worked
| where LogonType in ("Network", "RemoteInteractive")  // remote auth is the lateral signal
| where isnotempty(AccountName)
// 1 hour buckets so "many devices fast" stands out from slow daily activity
| summarize
    DistinctTargets = dcount(DeviceName),
    Targets         = make_set(DeviceName, 25),
    Logons          = count(),
    SourceIPs       = make_set(RemoteIP, 10)
    by AccountName, bin(TimeGenerated, 1h)
| where DistinctTargets >= 5                          // one account, 5+ machines in an hour
| sort by DistinctTargets desc
